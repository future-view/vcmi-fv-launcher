  "59": {
    "index": 59,
    "text": "{Good Luck}\n\nGood luck sometimes lets your armies get lucky attacks (double damage) in combat."
  },
  "60": {
    "index": 60,
    "text": "{Neutral Luck}\n\nWith neutral luck your armies will never have lucky or unlucky attacks on the enemy."
  },
  "61": {
    "index": 61,
    "text": "{Bad Luck}\n\nBad luck sometimes falls on your armies in combat, causing their attacks to only do half damage."
  },

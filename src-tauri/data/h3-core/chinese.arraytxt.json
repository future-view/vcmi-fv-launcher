  "2": {
    "index": 2,
    "text": "{攻击力}\n\n攻击力能提高你的部队的攻击力，使他们在战斗中更具杀伤力。"
  },
  "3": {
    "index": 3,
    "text": "{防御力}\n\n防御力能提高你的部队的防御力，减少他们在战斗中的损伤。"
  },
  "4": {
    "index": 4,

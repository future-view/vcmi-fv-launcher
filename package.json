{
  "name": "vcmi-fv-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.mjs",
    "version:bump": "node scripts/sync-version.mjs --bump",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish",
    "release:preview": "node scripts/release.mjs preview",
    "release:verify": "node scripts/release.mjs verify",
    "release:status": "node scripts/release.mjs status",
    "build:debug": "npm run version:sync && tauri build --debug",
    "build:console": "npm run version:sync && tauri build --debug --features console",
    "build:console:release": "npm run version:sync && tauri build --features console",
    "dev:tauri": "tauri dev",
    "verify:settings": "node scripts/read-modsettings.mjs",
    "realms:index": "node scripts/build-realms-index.mjs",
    "gen:settings": "node scripts/gen-settings-defaults.mjs",
    "gen:setting-keys": "node scripts/gen-setting-keys.mjs",
    "verify:wiki-cache": "node scripts/verify-wiki-cache.mjs",
    "rebuild:wiki-cache": "node scripts/rebuild-wiki-cache.mjs",
    "check:invoke-parity": "node scripts/check-invoke-parity.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:html-text": "node scripts/verify-html-text.mjs",
    "verify:maps": "cargo run --release --manifest-path src-tauri/Cargo.toml --example h3m_check",
    "test:maps": "cargo test --manifest-path src-tauri/Cargo.toml --lib infra::h3m",
    "hd:preview": "cd src-tauri && cargo test -p vcmi-fv-launcher hd_preview -- --ignored --nocapture",
    "hd:ai": "cd src-tauri && cargo test -p vcmi-fv-launcher hd_ai_preview -- --ignored --nocapture"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "tailwind-merge": "^2.5.5",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.1",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
